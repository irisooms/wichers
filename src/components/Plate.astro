---
interface Props { src?: string; alt: string; label?: string; ratio?: string; class?: string; }
const { src, alt, label, ratio = '4 / 5', class: cls = '' } = Astro.props;
---
<div class:list={['plate', cls]} style={`aspect-ratio:${ratio}`}>
  {src
    ? <img src={src} alt={alt} loading="lazy" decoding="async" />
    : <span class="plate__label note">{label ?? 'Image to follow'}</span>}
</div>
