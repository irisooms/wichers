---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Enquire">
  <section class="s s--paper enq">
    <div>
      <p class="note muted">Enquire</p>
      <h1 class="statement">By<br />appointment.</h1>
      <p class="body-text muted">
        Every piece is unique. Prices, availability and private viewings are shared on request.
        Commissions are considered selectively.
      </p>
    </div>
    <form class="form" id="enq" data-email={site.enquiryEmail}>
      <label><span class="note muted">Name</span><input name="name" required autocomplete="name" /></label>
      <label><span class="note muted">Email</span><input name="email" type="email" required autocomplete="email" /></label>
      <label><span class="note muted">Object (optional)</span><input name="object" id="obj" placeholder="e.g. Obj. 014" /></label>
      <label><span class="note muted">Message</span><textarea name="message" rows="5"></textarea></label>
      <button class="note" type="submit">Send enquiry</button>
    </form>
  </section>
</Base>
<script>
  // Prototype: hand the enquiry to the mail client. Swap for a form endpoint later.
  const form = document.getElementById('enq') as HTMLFormElement;
  const obj = new URLSearchParams(location.search).get('object');
  if (obj) (document.getElementById("obj") as HTMLInputElement).value = obj;
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const subject = `Enquiry${d.get('object') ? ' — ' + d.get('object') : ''}`;
    const body = `${d.get('message')}\n\n${d.get('name')}\n${d.get('email')}`;
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
<style>
  .enq { padding-top: 10rem; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 7vw, 8rem); align-items: end; }
  .form { display: grid; gap: 1.6rem; }
  label { display: grid; gap: 0.4rem; }
  input, textarea {
    font: inherit; color: inherit; background: transparent;
    border: 0; border-bottom: 1px solid rgba(14,13,12,.3); padding: 0.5rem 0; border-radius: 0;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--black); }
  button { justify-self: start; font-family: inherit; background: var(--black); color: var(--offwhite); border: 0; padding: 1rem 1.8rem; cursor: pointer; }
  @media (max-width: 800px) { .enq { grid-template-columns: 1fr; } }
</style>
